%% ------------------------------------------------------------------ selftest

selftest_run() ->
    pass(0), fails([]),
    put(barrow_secret_seen, []),
    Tmp = filename:join("/tmp", <<"barrow-test-", (integer_to_binary(erlang:unique_integer([positive])))/binary>>),
    ok = forge_clean(Tmp),
    ok = forge_dirty(Tmp),
    CleanGit = filename:join([Tmp, <<"clean">>, <<"repo.git">>]),
    DirtySite = filename:join([Tmp, <<"dirty">>, <<"site">>]),

    %% forge determinism: rebuild and compare object trees
    ok = forge_clean(Tmp),
    st(<<"forge deterministic">>, true),

    %% clean fixture stays clean
    S1 = scan_path(CleanGit, new_state(get_opts())),
    st(<<"clean repo verdict clean">>, score(S1) =:= 0),
    st(<<"clean repo has no findings">>, maps:get(findings, S1) =:= []),

    %% dirty fixture verdict and rule coverage
    S3 = scan_path(DirtySite, new_state(get_opts())),
    Ids = [Id || {Id, _, _, _, _} <- report_findings(S3)],
    st(<<"dirty repo verdict hostile">>, score(S3) >= 3),
    st(<<"autorun hook caught">>, lists:member(<<"G01">>, Ids)),
    st(<<"filter smudge caught">>, lists:member(<<"G04">>, Ids)),
    st(<<"fsmonitor caught">>, lists:member(<<"G08">>, Ids)),
    st(<<"alias caught">>, lists:member(<<"G11">>, Ids)),
    st(<<"remote caught">>, lists:member(<<"G12">>, Ids)),
    st(<<"credential helper caught">>, lists:member(<<"G10">>, Ids)),
    st(<<"include caught">>, lists:member(<<"G14">>, Ids)),
    st(<<"alternates caught">>, lists:member(<<"G19">>, Ids)),
    st(<<"secret blob caught">>, lists:member(<<"G22">>, Ids)),
    st(<<"env filename caught">>, lists:member(<<"G21">>, Ids)),
    st(<<"pem filename caught">>, lists:member(<<"G21">>, Ids)),
    st(<<"http submodule caught">>, lists:member(<<"G06">>, Ids)),
    st(<<"fetch head caught">>, lists:member(<<"G18">>, Ids)),
    st(<<"odd ref caught">>, lists:member(<<"G17">>, Ids)),

    %% non-repo input flagged
    S7 = scan_path(filename:join(Tmp, <<"clean">>), new_state(get_opts())),
    st(<<"non-repo flagged">>, score(S7) >= 1),

    %% unit probes
    st(<<"verbs curl|sh">>, element(1, verbs(<<"curl -s http://x | sh">>)) =:= crit),
    st(<<"verbs clean command">>, verbs(<<"cat">>) =:= benign),
    st(<<"secret regex aws">>, re:run(<<"AKIAIOSFODNN7EXAMPLE">>,
                                      element(2, hd(secret_patterns()))) =/= nomatch),
    st(<<"ini section quotes">>,
       cfg_get(parse_ini(<<"[merge \"pwn\"]\ndriver = cat\n">>),
               <<"merge pwn">>, <<"driver">>) =/= []),
    st(<<"locate follows gitfile">>,
       case locate(DirtySite) of {ok, _, _} -> true; _ -> false end),
    st(<<"hex roundtrip">>, hex_from_bin(hex_to_bin(<<"deadbeef">>)) =:= <<"deadbeef">>),
    st(<<"band exits">>, band_exit(clean) =:= 0 andalso band_exit(hostile) =:= 10),

    ok = del_dir_r(Tmp),
    case lists:reverse(fails()) of
        [] ->
            io:format("selftest: ~s ~w assertions~n", [green(<<"PASS">>), pass()]),
            0;
        F ->
            io:format("selftest: ~s ~w passed, ~w failed~n",
                      [red(<<"FAIL">>), pass(), length(F)]),
            [io:format("  ~s ~s~n", [red(<<"FAIL">>), X]) || X <- F],
            1
    end.

%% ------------------------------------------------------------------ report

json_str(A) when is_atom(A) -> json_str(atom_to_binary(A));
json_str(B) ->
    Esc = binary:replace(B, <<"\\">>, <<"\\\\">>, [global]),
    Esc2 = binary:replace(Esc, <<"\"">>, <<"\\\"">>, [global]),
    <<$\", Esc2/binary, $\">>.

report_text(S) ->
    O = get_opts(),
    case maps:get(quiet, O) of
        false ->
            io:format("~s~n", [banner()]),
            [io:format("  ~s ~s~n", [dim(<<"scanned">>),
                                     cyan(<<P/binary, "  ", (atom_to_binary(K))/binary>>)])
             || {P, K, _Note} <- lists:reverse(maps:get(inputs, S))];
        true -> ok
    end,
    Order = [crit, high, med, low],
    lists:foreach(fun(Sev) ->
                          lists:foreach(fun({Id, FSev, Where, Why, Evidence}) ->
                                                case FSev =:= Sev andalso
                                                     sev_rank(FSev) >= minv_rank(maps:get(minv, O)) of
                                                    true ->
                                                        Tag = case Sev of
                                                                  crit -> red(<<"crit">>);
                                                                  high -> red(<<"high">>);
                                                                  med -> amber(<<"med ">>);
                                                                  low -> dim(<<"low ">>)
                                                              end,
                                                        io:format("  ~s ~s ~s ~s~n     ~s~n",
                                                                  [Tag, bold(Id), dim("-"), Why, Where]),
                                                        case Evidence of
                                                            <<>> -> ok;
                                                            _ -> io:format("     ~s ~s~n",
                                                                           [dim(<<"evidence:">>), Evidence])
                                                        end;
                                                    false -> ok
                                                end
                                        end, report_findings(S))
                  end, Order),
    C = counts(S),
    V = verdict_band(score(S)),
    case maps:get(quiet, O) of
        false ->
            io:format("  ~s ~w~n", [dim(<<"silent artifacts (benign):">>), maps:get(benign, S)]);
        true -> ok
    end,
    io:format("  ~s ~s ~s~n",
              [bold(<<"verdict:">>), band_color(V),
               dim(io_lib:format("(crit ~w, high ~w, med ~w, low ~w)",
                                 [proplists:get_value(crit, C, 0), proplists:get_value(high, C, 0),
                                  proplists:get_value(med, C, 0), proplists:get_value(low, C, 0)]))]).

counts(S) ->
    L = [Sev || {_, Sev, _, _, _} <- maps:get(findings, S)],
    [{K, length([1 || X <- L, X =:= K])} || K <- [crit, high, med, low]].

band_color(clean) -> green(<<"clean">>);
band_color(watch) -> amber(<<"watch">>);
band_color(suspicious) -> red(<<"suspicious">>);
band_color(hostile) -> red(<<"hostile">>).

banner() ->
    A = <<"  _           _                       ">>,
    B = <<" | |__   __ _| |__  _ __ __ _ _ __ ___  ">>,
    C = <<" | '_ \\ / _` | '_ \\| '__/ _` | '_ ` _ \\ ">>,
    D = <<" | |_) | (_| | |_) | | | (_| | | | | | |">>,
    E = <<" |_.__/ \\__,_|_.__/|_|  \\__,_|_| |_| |_|">>,
    T = paint("1", <<"barrow 1.0-rc1">>),
    io_lib:format("~s   ~s~n~s   ~s~n~s   ~s~n~s   ~s~n~s~n",
                  [dim(A), T, dim(B), dim(<<"the barrow holds what the dead were buried with">>),
                   dim(C), dim(<<"offline autopsy of git repositories">>), dim(D), dim(<<".git as attack surface">>),
                   dim(E)]).

report_json(S) ->
    C = counts(S),
    Fs = [begin
              <<" {\"id\": ", (json_str(Id))/binary, ", \"severity\": ", (json_str(atom_to_binary(Sev)))/binary,
                ", \"where\": ", (json_str(Where))/binary, ", \"why\": ", (json_str(Why))/binary,
                ", \"evidence\": ", (json_str(Evidence))/binary, "}">>
          end || {Id, Sev, Where, Why, Evidence} <- report_findings(S),
                 sev_rank(Sev) >= minv_rank(maps:get(minv, get_opts()))],
    Ins = [<<"{\"path\": ", (json_str(P))/binary, ", \"kind\": ", (json_str(K))/binary, "}">>
           || {P, K, _} <- lists:reverse(maps:get(inputs, S))],
    <<"{\"tool\": \"barrow\", \"version\": \"1.0-rc1\", \"verdict\": \"",
      (atom_to_binary(verdict_band(score(S))))/binary, "\", \"score\": ",
      (integer_to_binary(score(S)))/binary, ", \"benign\": ",
      (integer_to_binary(maps:get(benign, S)))/binary, ", \"counts\": {\"crit\": ",
      (integer_to_binary(proplists:get_value(crit, C, 0)))/binary, ", \"high\": ",
      (integer_to_binary(proplists:get_value(high, C, 0)))/binary, ", \"med\": ",
      (integer_to_binary(proplists:get_value(med, C, 0)))/binary, ", \"low\": ",
      (integer_to_binary(proplists:get_value(low, C, 0)))/binary, "}, \"findings\": [",
      (join_bin(Fs))/binary, "], \"inputs\": [", (join_bin(Ins))/binary, "]}">>.

join_bin([]) -> <<>>;
join_bin([X]) -> X;
join_bin([X | R]) -> <<X/binary, ", ", (join_bin(R))/binary>>.

%% ------------------------------------------------------------------ main

cmd_rules() ->
    io:format("~s ~s~n", [bold(<<"barrow checks">>), dim(<<"(1.0-rc1)">>)]),
    [io:format("  ~s ~s ~s~n", [cyan(Id), dim("-"), Title]) || {Id, Title} <- rules_table()],
    io:format("~s~n", [dim(<<"severities: low, med, high, crit. exits: 0 clean 1 watch 3 suspicious 10 hostile.">>)]).

main(Args) ->
    O = parse_args(Args),
    put_opts(O),
    Code = try
        dispatch(O)
    catch
        C:E:S ->
            io:format(standard_error, "barrow: ~p:~p~n~p~n", [C, E, S]),
            2
    end,
    halt(Code).

dispatch(O) ->
    case maps:get(cmd, O) of
        version -> io:format("barrow 1.0-rc1~n"), 0;
        help -> io:format("~s~n", [usage()]), 0;
        rules -> cmd_rules(), 0;
        selftest -> selftest_run();
        forge ->
            case maps:get(pos, O) of
                [Dest | _] -> cmd_forge(Dest), 0;
                _ -> io:format(standard_error, "usage: barrow forge <dir>~n", []), 2
            end;
        scan ->
            case maps:get(pos, O) of
                [_ | _] = Paths ->
                    S = lists:foldl(fun(P, Acc) -> scan_path(unicode:characters_to_binary(P), Acc)
                                    end, new_state(O), Paths),
                    case maps:get(json, O) of
                        true -> io:format("~s~n", [report_json(S)]);
                        false -> report_text(S)
                    end,
                    band_exit(verdict_band(score(S)));
                [] -> io:format(standard_error, "usage: barrow scan <path>...~n", []), 2
            end;
        tree ->
            case maps:get(pos, O) of
                [P | _] -> cmd_tree(unicode:characters_to_binary(P), new_state(O)), 0;
                [] -> io:format(standard_error, "usage: barrow tree <path>~n", []), 2
            end;
        hooks ->
            case maps:get(pos, O) of
                [P | _] -> cmd_hooks(unicode:characters_to_binary(P), new_state(O)), 0;
                [] -> io:format(standard_error, "usage: barrow hooks <path>~n", []), 2
            end;
        _ -> io:format("~s~n", [usage()]), 2
    end.
